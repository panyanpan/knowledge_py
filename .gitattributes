# 统一换行符：仓库内一律存 LF，检出时由各平台工具自行处理
* text=auto eol=lf

# 显式声明源码类型（避免被误判为二进制或二次转换）
*.py   text eol=lf
*.ts   text eol=lf
*.vue  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.sql  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Windows 脚本保留 CRLF，Shell 脚本强制 LF（否则在 Linux 上无法执行）
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.sh   text eol=lf

# 二进制资源不做换行符转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
